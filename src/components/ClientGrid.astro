---
// The client tiles inside a timeline entry.
//
// Each tile identifies a client factually: an icon (or a real monochrome wordmark
// where one is available), the name as text, what kind of organisation it is, its
// scale, and, importantly, exactly how involved Christian was. "Sole developer"
// and "part of a larger team" both appear, because the honest one is always the
// right one.

import Icon from './Icon.astro';
import type { Client } from '../data/experience';

interface Props {
	clients: Client[];
	label: string;
}

const { clients, label } = Astro.props;

/*
	Wordmarks are inlined, not <img src>.

	An SVG loaded through <img> is an isolated document: it can't see the page's
	`color`, so `fill="currentColor"` inside it resolves to the initial value ,
	black. That's why the PostNord mark rendered as a black wordmark on a dark
	tile no matter what colour the CSS set. Inlining puts the SVG in the same
	document, so currentColor inherits and one rule covers both themes.
*/
const logos = import.meta.glob<string>('../assets/logos/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

function logoMarkup(name: string): string | undefined {
	const entry = Object.entries(logos).find(([path]) =>
		path.endsWith(`/${name}.svg`),
	);
	return entry?.[1];
}
---

<div class="clients">
	<span class="clients-label eyebrow">{label}</span>
	<div class="client-grid">
		{clients.map((client) => {
			const wordmark = client.logo ? logoMarkup(client.logo) : undefined;
			return (
			<div class="client-tile">
				<div class="client-head">
					{wordmark ? (
						// The wordmark already spells the company name, so the visible
						// text label would duplicate it, it stays for screen readers.
						<span class="client-logo" set:html={wordmark} />
					) : (
						<Icon name={client.icon} size={20} class="client-icon" />
					)}
					<span class="client-name" class:list={{ 'sr-only': !!wordmark }}>
						{client.name}
					</span>
				</div>
				<span class="client-kind mono">{client.kind}</span>
				<p class="client-scale">{client.scale}</p>
				<p class="client-role">{client.role}</p>
			</div>
			);
		})}
	</div>
</div>

<style>
	.clients {
		margin-top: 1.5rem;
	}
	.clients-label {
		display: block;
		margin-bottom: 0.9rem;
	}
	.client-grid {
		display: grid;
		/*
			auto-FILL, not auto-fit: a role with a single client (Plejd, Enginio)
			would otherwise stretch one tile across the full card width, which reads
			as a banner rather than as one item in a set.
		*/
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: 0.9rem;
	}
	.client-tile {
		background: var(--bg-elevated-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.95rem 1rem 1rem;
		transition: border-color 0.15s ease;
	}
	.client-tile:hover {
		border-color: var(--border-strong);
	}
	.client-head {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.5rem;
		min-height: 22px;
	}
	.client-icon {
		color: var(--text-muted);
		flex-shrink: 0;
		transition: color 0.15s ease;
	}
	.client-tile:hover .client-icon {
		color: var(--accent);
	}
	/*
		Inlined wordmarks inherit currentColor, so one rule covers both themes:
		near-white on the dark theme, near-black on the light one.
	*/
	.client-logo {
		display: inline-flex;
		align-items: center;
		color: var(--text);
		opacity: 0.85;
		transition: opacity 0.15s ease;
	}
	.client-tile:hover .client-logo {
		opacity: 1;
	}
	.client-logo :global(svg) {
		height: 15px;
		width: auto;
		max-width: 100%;
		display: block;
	}
	.client-name {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text);
		line-height: 1.25;
	}
	.client-kind {
		display: block;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
		margin-bottom: 0.45rem;
	}
	.client-scale {
		margin: 0 0 0.35rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.client-role {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		.client-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
