---
// The client tiles inside a timeline entry.
//
// Each tile identifies a client factually: an icon (or a real monochrome wordmark
// where one is available), the name as text, what kind of organisation it is, its
// scale, and, importantly, exactly how involved Christian was. "Sole developer"
// and "part of a larger team" both appear, because the honest one is always the
// right one.

import Icon from './Icon.astro';
import type { Client } from '../data/experience';

interface Props {
	clients: Client[];
	label: string;
}

const { clients, label } = Astro.props;

/*
	Client wordmarks come in two shapes, and both end up monochrome.

	SVG ones are inlined rather than used as <img src>. An SVG loaded through
	<img> is an isolated document: it can't see the page's `color`, so
	`fill="currentColor"` inside it resolves to the initial value, black. That is
	why the PostNord mark first rendered as a black wordmark on a dark tile no
	matter what the CSS said. Inlining puts it in the same document, so
	currentColor inherits and one rule covers both themes.

	PNG ones are pre-baked to a black silhouette on transparency, because those
	logos were only available as raster. The dark theme inverts them to white in
	CSS and the light theme leaves them black, which lands in the same place.
*/
const svgLogos = import.meta.glob<string>('../assets/logos/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const pngLogos = import.meta.glob<{ default: { src: string } }>(
	'../assets/logos/*.png',
	{ eager: true },
);

function svgMarkup(name: string): string | undefined {
	return Object.entries(svgLogos).find(([p]) => p.endsWith(`/${name}.svg`))?.[1];
}

function pngSrc(name: string): string | undefined {
	const hit = Object.entries(pngLogos).find(([p]) => p.endsWith(`/${name}.png`));
	return hit?.[1]?.default?.src;
}
---

<div class="clients">
	<span class="clients-label eyebrow">{label}</span>
	<div class="client-grid">
		{clients.map((client) => {
			const svg = client.logo ? svgMarkup(client.logo) : undefined;
			const png = client.logo && !svg ? pngSrc(client.logo) : undefined;
			const hasLogo = !!(svg || png);
			// A wordmark spells the company name out, so repeating it as text is
			// noise. A monogram (Plejd's "p", Stadsmission's "G") does not, and
			// neither does "1177" out of context, so those keep the visible label.
			const hideName = hasLogo && !client.logoNeedsLabel;
			return (
			<div class="client-tile">
				<div class="client-head">
					{svg && <span class="client-logo" set:html={svg} />}
					{png && <img class="client-logo client-logo-raster" src={png} alt="" aria-hidden="true" />}
					{!hasLogo && <Icon name={client.icon} size={20} class="client-icon" />}
					<span class="client-name" class:list={{ 'sr-only': hideName }}>
						{client.name}
					</span>
				</div>
				<span class="client-kind mono">{client.kind}</span>
				<p class="client-scale">{client.scale}</p>
				<p class="client-role">{client.role}</p>
			</div>
			);
		})}
	</div>
</div>

<style>
	.clients {
		margin-top: 1.5rem;
	}
	.clients-label {
		display: block;
		margin-bottom: 0.9rem;
	}
	.client-grid {
		display: grid;
		/*
			auto-FILL, not auto-fit: a role with a single client (Plejd, Enginio)
			would otherwise stretch one tile across the full card width, which reads
			as a banner rather than as one item in a set.
		*/
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: 0.9rem;
	}
	.client-tile {
		background: var(--bg-elevated-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.95rem 1rem 1rem;
		transition: border-color 0.15s ease;
	}
	.client-tile:hover {
		border-color: var(--border-strong);
	}
	/*
		Logo on top, name underneath. Side by side worked for a short label but
		wrapped badly for the long one ("IEMS, BabySlides, Doxa Bostad, Hagab"),
		which pushed the logo off-centre and left the row looking lopsided.
		Tiles whose logo already spells the name hide it via .sr-only, which is
		absolutely positioned and so adds no height here.
	*/
	.client-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 0.7rem;
		min-height: 34px;
		text-align: center;
	}
	.client-icon {
		color: var(--text-muted);
		flex-shrink: 0;
		transition: color 0.15s ease;
	}
	.client-tile:hover .client-icon {
		color: var(--accent);
	}
	/*
		Inlined wordmarks inherit currentColor, so one rule covers both themes:
		near-white on the dark theme, near-black on the light one.
	*/
	.client-logo {
		display: inline-flex;
		align-items: center;
		color: var(--text);
		opacity: 0.85;
		transition: opacity 0.15s ease;
	}
	.client-tile:hover .client-logo {
		opacity: 1;
	}
	/*
		Bounded by a box rather than a fixed height. These lockups have wildly
		different proportions, from PostNord's long single line to Nordic
		Wellness and Fred's, which stack two lines and turn illegible if the
		whole thing is squeezed to one line's height.
	*/
	.client-logo :global(svg) {
		width: auto;
		height: auto;
		max-height: 32px;
		max-width: 140px;
		display: block;
	}
	/*
		Raster logos ship as black silhouettes. The dark theme inverts them to
		white; the light theme uses them as-is, so both themes get the same
		monochrome treatment as the inlined SVGs.
	*/
	.client-logo-raster {
		width: auto;
		height: auto;
		max-height: 32px;
		max-width: 140px;
		object-fit: contain;
		display: block;
		filter: invert(1);
		/*
			global.css rounds every <img> by --radius-sm, which is fine for photos
			and very much not fine here: on a 28px-tall wordmark a 6px radius eats
			the corners of the letterforms. Logos are not cards.
		*/
		border-radius: 0;
	}
	:global([data-theme='light']) .client-logo-raster {
		filter: none;
	}
	.client-name {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text);
		line-height: 1.25;
	}
	.client-kind {
		display: block;
		text-align: center;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
		margin-bottom: 0.45rem;
	}
	.client-scale {
		margin: 0 0 0.35rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.client-role {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		.client-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
