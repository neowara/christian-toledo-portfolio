---
import HeaderLink from './HeaderLink.astro';
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<header class="site">
	<nav class="wrap">
		<a href="/" class="brand">christian<span>.</span>toledo</a>
		<div class="nav-links">
			<a href="/#work">Work</a>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="nav-right">
			<a class="icon-link" href={GITHUB_URL} target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
				<span class="sr-only">GitHub Profile</span>
				<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
			</a>
			<a class="icon-link" href={LINKEDIN_URL} target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">
				<span class="sr-only">LinkedIn Profile</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
			</a>
			<div class="lang-toggle" role="group" aria-label="Language">
				<button class="lang-btn" data-lang="en" aria-label="English">EN</button>
				<span class="lang-sep">|</span>
				<button class="lang-btn" data-lang="sv" aria-label="Svenska">SV</button>
			</div>
			<button class="theme-toggle" aria-label="Toggle color theme">
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
			</button>
		</div>
	</nav>
</header>

<div id="google_translate_element" class="sr-only"></div>

<script>
	const toggle = document.querySelector('.theme-toggle');
	toggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
		const next = current === 'light' ? 'dark' : 'light';
		root.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
	});
</script>

<script is:inline>
	function googleTranslateElementInit() {
		new google.translate.TranslateElement(
			{ pageLanguage: 'en', includedLanguages: 'sv', autoDisplay: false },
			'google_translate_element'
		);
	}
</script>
<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<script>
	function currentGoogTransLang(): string {
		const match = document.cookie.match(/googtrans=\/en\/(\w+)/);
		return match ? match[1] : 'en';
	}

	function setLangCookie(lang: string) {
		const host = window.location.hostname;
		const expire = lang === 'en' ? 'expires=Thu, 01 Jan 1970 00:00:00 UTC;' : '';
		const value = lang === 'en' ? '' : `/en/${lang}`;
		document.cookie = `googtrans=${value}; ${expire} path=/;`;
		document.cookie = `googtrans=${value}; ${expire} path=/; domain=${host};`;
		document.cookie = `googtrans=${value}; ${expire} path=/; domain=.${host};`;
	}

	function updateLangButtons() {
		const active = currentGoogTransLang();
		document.querySelectorAll('.lang-btn').forEach((btn) => {
			btn.classList.toggle('active', (btn as HTMLElement).dataset.lang === active);
		});
	}

	document.querySelectorAll('.lang-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const lang = (btn as HTMLElement).dataset.lang ?? 'en';
			if (lang === currentGoogTransLang()) return;
			setLangCookie(lang);
			window.location.reload();
		});
	});

	updateLangButtons();
</script>

<style>
	header.site {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.wrap {
		max-width: var(--container-width);
		margin: 0 auto;
		padding-inline: 1.5rem;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 0;
	}
	.brand {
		font-weight: 700;
		font-size: 1rem;
		font-family: var(--mono);
		letter-spacing: -0.01em;
		color: var(--text);
	}
	.brand span {
		color: var(--accent);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}
	.nav-links a {
		font-size: 0.92rem;
		color: var(--text-muted);
		padding: 0.3rem 0;
		border-bottom: 2px solid transparent;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.icon-link {
		color: var(--text-muted);
		display: flex;
	}
	.icon-link:hover {
		color: var(--accent);
	}
	.lang-toggle {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		height: 34px;
		padding: 0 0.6rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-elevated);
		font-family: var(--mono);
		font-size: 0.78rem;
	}
	.lang-sep {
		color: var(--border-strong);
	}
	.lang-btn {
		background: none;
		border: none;
		padding: 0;
		color: var(--text-dim);
		cursor: pointer;
		font-family: var(--mono);
		font-size: 0.78rem;
		font-weight: 600;
	}
	.lang-btn:hover {
		color: var(--text);
	}
	.lang-btn.active {
		color: var(--accent);
	}
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-elevated);
		color: var(--text-muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.theme-toggle svg {
		width: 16px;
		height: 16px;
	}
	:global([data-theme='dark']) .icon-moon {
		display: none;
	}
	:global([data-theme='light']) .icon-sun {
		display: none;
	}
	@media (max-width: 720px) {
		.nav-links {
			display: none;
		}
	}
</style>
