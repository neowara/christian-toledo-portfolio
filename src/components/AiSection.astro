---
// #ai, how I work with AI.
//
// Structure is deliberate: three pillars (what I run and why), then the figures block
// (the operating evidence), then the tool strip (supporting detail, smallest). A tool
// list is what everyone has; the figures are the part that's actually checkable, so
// they get the visual weight.

import { AI_PRACTICE, AI_PRACTICE_SV } from '../consts';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/paths';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const strings = t(lang).ai;
const ai = lang === 'sv' ? AI_PRACTICE_SV : AI_PRACTICE;
---

<section id="ai">
	<div class="section-head">
		<span class="eyebrow">{strings.eyebrow}</span>
		<h2>{strings.title}</h2>
		<p>{strings.description}</p>
	</div>

	<div class="pillars">
		{ai.pillars.map((pillar) => (
			<div class="pillar card">
				<span class="pillar-node" aria-hidden="true"></span>
				<h3>{pillar.title}</h3>
				<p>{pillar.body}</p>
			</div>
		))}
	</div>

	<div class="figures card">
		<span class="eyebrow">{strings.figuresLabel}</span>
		<div class="figure-grid">
			{ai.figures.map((f) => (
				<div class="figure">
					<span class="figure-value mono">{f.figure}</span>
					<span class="figure-caption">{f.caption}</span>
				</div>
			))}
		</div>
		<p class="figures-closing">{ai.closing}</p>
	</div>

	<div class="tools">
		<span class="eyebrow">{strings.toolsLabel}</span>
		<div class="tool-groups">
			{ai.toolGroups.map((group) => (
				<div class="tool-group">
					<span class="tool-label mono">{group.label}</span>
					<div class="tool-list">
						{group.tools.map((tool) => <span class="tool">{tool}</span>)}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	section {
		padding: 3.5rem 0;
	}
	.section-head {
		margin-bottom: 2.5rem;
		max-width: 640px;
	}
	.section-head p {
		margin-top: 0.8rem;
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}
	.pillar {
		position: relative;
		padding: 1.6rem 1.5rem 1.5rem;
	}
	.pillar-node {
		position: absolute;
		top: 1.7rem;
		left: 0;
		width: 3px;
		height: 1.1rem;
		border-radius: 0 2px 2px 0;
		background: var(--accent);
	}
	.pillar h3 {
		font-size: 1.05rem;
		margin: 0 0 0.6rem;
	}
	.pillar p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-muted);
	}

	.figures {
		margin-top: 1.5rem;
		padding: 1.8rem 1.75rem 1.6rem;
	}
	.figures .eyebrow {
		display: block;
		margin-bottom: 1.3rem;
	}
	.figure-grid {
		display: grid;
		/*
			280px lands three per row on the 1080px container, so six figures read as
			a tidy 3x2 rather than 4+2 with a hole in the second row.
		*/
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.4rem 1.8rem;
	}
	.figure {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding-left: 0.9rem;
		border-left: 2px solid var(--border-strong);
	}
	.figure-value {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--accent);
		line-height: 1.3;
	}
	.figure-caption {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}
	.figures-closing {
		margin: 1.6rem 0 0;
		padding-top: 1.3rem;
		border-top: 1px solid var(--border);
		font-size: 0.92rem;
		color: var(--text-muted);
		max-width: 62ch;
	}

	.tools {
		margin-top: 2rem;
	}
	.tools .eyebrow {
		display: block;
		margin-bottom: 1rem;
	}
	.tool-groups {
		display: flex;
		flex-wrap: wrap;
		gap: 1.6rem 2.4rem;
	}
	.tool-group {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.tool-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-dim);
	}
	.tool-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tool {
		font-family: var(--mono);
		font-size: 0.78rem;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: 5px;
		color: var(--text-muted);
		background: var(--bg-elevated);
	}

	@media (max-width: 640px) {
		.figures {
			padding: 1.4rem 1.2rem;
		}
		.pillar {
			padding: 1.4rem 1.2rem;
		}
	}
</style>
