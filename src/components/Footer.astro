---
import { GITHUB_URL, LINKEDIN_URL, EMAIL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site">
	<div class="wrap">
		<div class="footer-grid">
			<div class="footer-brand">
				<div class="brand">christian<span>.</span>toledo</div>
				<p class="mono">Full-stack engineer · Göteborg, Sweden</p>
			</div>
			<div class="footer-links">
				<div class="footer-col">
					<h4>Site</h4>
					<a href="/">Home</a>
					<a href="/about">About</a>
					<a href="/blog">Blog</a>
				</div>
				<div class="footer-col">
					<h4>Projects</h4>
					<a href="https://github.com/neowara/turbo" target="_blank" rel="noopener noreferrer">Turbo</a>
					<a href="https://github.com/neowara/casa-verde" target="_blank" rel="noopener noreferrer">casa-verde</a>
				</div>
				<div class="footer-col">
					<h4>Connect</h4>
					<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a href={`mailto:${EMAIL}`}>Email</a>
				</div>
			</div>
		</div>
		<div class="footer-bottom">&copy; {year} Christian Toledo.</div>
	</div>
</footer>

<style>
	footer.site {
		border-top: 1px solid var(--border);
		padding: 2.6rem 0 2.2rem;
		margin-top: 3rem;
	}
	.wrap {
		max-width: var(--container-width);
		margin: 0 auto;
		padding-inline: 1.5rem;
	}
	.footer-grid {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.footer-brand .brand {
		font-family: var(--mono);
		font-weight: 700;
		color: var(--text);
	}
	.footer-brand .brand span {
		color: var(--accent);
	}
	.footer-brand p {
		margin: 0.3rem 0 0;
		font-size: 0.88rem;
	}
	.footer-links {
		display: flex;
		gap: 2.5rem;
		flex-wrap: wrap;
	}
	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.footer-col h4 {
		font-family: var(--mono);
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-dim);
		margin-bottom: 0.3rem;
		font-weight: 600;
	}
	.footer-links a {
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-bottom {
		margin-top: 2.2rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--border);
		font-size: 0.82rem;
		color: var(--text-dim);
	}
</style>
