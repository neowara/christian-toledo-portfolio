---
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="footer-info">
			<p class="footer-title">{SITE_TITLE}</p>
			<p class="footer-tagline">Full-Stack Developer | Infrastructure Enthusiast</p>
			<p class="footer-copyright">&copy; {today.getFullYear()} {SITE_TITLE}. Built with passion and cyberpunk aesthetics.</p>
		</div>
		<div class="footer-links">
			<div class="link-group">
				<h4>Navigate</h4>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/blog">Blog</a>
			</div>
			<div class="link-group">
				<h4>Projects</h4>
				<a href="https://jellyfin.casa-verde.casa" target="_blank" rel="noopener noreferrer">Jellyfin</a>
				<a href="https://navidrome.casa-verde.casa" target="_blank" rel="noopener noreferrer">Navidrome</a>
				<a href="https://immich.casa-verde.casa" target="_blank" rel="noopener noreferrer">Immich</a>
			</div>
			<div class="link-group">
				<h4>Connect</h4>
				<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href="mailto:christiantoledo@live.com">Email</a>
			</div>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 3em 2em;
		background: var(--bg-card);
		border-top: 1px solid rgba(0, 255, 255, 0.2);
		box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
		margin-top: 5rem;
	}

	.footer-content {
		max-width: var(--container-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 3rem;
	}

	.footer-info {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-title {
		font-size: 1.5rem;
		font-weight: 700;
		background: linear-gradient(135deg, var(--neon-cyan), var(--neon-magenta));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	.footer-tagline {
		color: var(--text-secondary);
		font-size: 0.95rem;
		margin: 0;
	}

	.footer-copyright {
		color: var(--text-dim);
		font-size: 0.85rem;
		margin: 1rem 0 0;
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.link-group {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.link-group h4 {
		color: var(--neon-cyan);
		font-size: 1rem;
		margin: 0 0 0.5rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.link-group a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.95rem;
		transition: all 0.3s ease;
		position: relative;
		width: fit-content;
	}

	.link-group a::before {
		display: none;
	}

	.link-group a:hover {
		color: var(--neon-cyan);
		transform: translateX(4px);
	}

	@media (max-width: 768px) {
		.footer-content {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-links {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		footer {
			padding: 2em 1em;
		}

		.footer-title {
			font-size: 1.3rem;
		}
	}
</style>
