---
// Inline SVG icons for client tiles and system cards.
//
// Inline rather than <img> so they inherit currentColor and work in both themes
// without a second asset per icon. Matches the existing hand-rolled icon style on
// the casa-verde project card: 24px box, stroke-based, stroke-width 1.6, round caps.
// No icon library, there are twelve of these and a dependency isn't worth it.

import type { ClientIcon } from '../data/experience';
import type { SystemIcon } from '../data/systems';

interface Props {
	name: ClientIcon | SystemIcon;
	size?: number;
	class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{/* ── Client icons ─────────────────────────────────────────────── */}
	{name === 'health' && (
		<Fragment>
			<path d="M4.5 8.5h3l1.5-3 3 6 1.5-3h6"></path>
			<path d="M20 11.5v4a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-4"></path>
		</Fragment>
	)}
	{name === 'parcel' && (
		<Fragment>
			<path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"></path>
			<path d="M3 7.5 12 12l9-4.5M12 12v9"></path>
		</Fragment>
	)}
	{name === 'community' && (
		<Fragment>
			<path d="M12 20s-6-3.8-6-8a3.4 3.4 0 0 1 6-2.2A3.4 3.4 0 0 1 18 12c0 4.2-6 8-6 8z"></path>
			<path d="M5 6.5a2 2 0 1 1 3-1.7M19 6.5a2 2 0 1 0-3-1.7"></path>
		</Fragment>
	)}
	{name === 'fitness' && (
		<Fragment>
			<path d="M4 9v6M7 7v10M17 7v10M20 9v6"></path>
			<path d="M7 12h10"></path>
		</Fragment>
	)}
	{name === 'lightbulb' && (
		<Fragment>
			<path d="M9.5 18h5M10 21h4"></path>
			<path d="M12 3a6 6 0 0 0-3.5 10.9c.6.4.9 1 .9 1.7v.4h5.2v-.4c0-.7.3-1.3.9-1.7A6 6 0 0 0 12 3z"></path>
		</Fragment>
	)}
	{name === 'megaphone' && (
		<Fragment>
			<path d="M4 10v4a1 1 0 0 0 1 1h3l7 4V5L8 9H5a1 1 0 0 0-1 1z"></path>
			<path d="M18.5 9.5a3.5 3.5 0 0 1 0 5"></path>
		</Fragment>
	)}
	{name === 'cms' && (
		<Fragment>
			<rect x="3" y="4" width="18" height="16" rx="2"></rect>
			<path d="M3 9h18M7 13h6M7 16.5h9"></path>
		</Fragment>
	)}

	{/* ── System icons ─────────────────────────────────────────────── */}
	{name === 'media' && (
		<Fragment>
			<rect x="3" y="5" width="18" height="14" rx="2"></rect>
			<path d="M3 9h18M7 5v4M17 5v4"></path>
			<path d="m11 12.5 3.5 2-3.5 2z"></path>
		</Fragment>
	)}
	{name === 'home' && (
		<Fragment>
			<path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"></path>
			<path d="M9.5 15.5a3.5 3.5 0 0 1 5 0M11.4 13a6 6 0 0 1 1.2 0"></path>
		</Fragment>
	)}
	{name === 'game' && (
		<Fragment>
			<path d="M7.5 8h9a4.5 4.5 0 0 1 4.4 5.4l-.6 3A2.6 2.6 0 0 1 15.9 17L14 15h-4l-1.9 2a2.6 2.6 0 0 1-4.4-.6l-.6-3A4.5 4.5 0 0 1 7.5 8z"></path>
			<path d="M8 10.5v2M7 11.5h2M15.5 11h.01M17.5 12.5h.01"></path>
		</Fragment>
	)}
	{name === 'shield' && (
		<Fragment>
			<path d="M12 3.5 5 6v5.5c0 4 3 7.4 7 8.9 4-1.5 7-4.9 7-8.9V6z"></path>
			<path d="m9.5 12 1.8 1.8 3.4-3.6"></path>
		</Fragment>
	)}
	{name === 'platform' && (
		<Fragment>
			<rect x="3" y="3" width="7" height="7" rx="1"></rect>
			<rect x="14" y="3" width="7" height="7" rx="1"></rect>
			<rect x="3" y="14" width="7" height="7" rx="1"></rect>
			<rect x="14" y="14" width="7" height="7" rx="1"></rect>
			<path d="M10 6.5h4M6.5 10v4M17.5 10v4M10 17.5h4"></path>
		</Fragment>
	)}
</svg>
