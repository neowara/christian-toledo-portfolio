---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, EMAIL, PROJECTS, EXPERIENCE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header lang="en" />
		<main>
			<section class="hero">
				<span class="eyebrow">Göteborg, Sweden</span>
				<h1>Christian Toledo.<br>Full-stack engineer who ships and operates his own systems.</h1>
				<p class="lead">Close to 7 years building production web and mobile apps across product companies and consultancies. The more interesting proof of how I work is what I build when nobody's asking: an Android app that talks directly to hardware over Bluetooth, and a home lab run with the documentation discipline of a production team.</p>
				<p class="sub">Most recently a fullstack developer at Dear Friends and Nexer AB, working across clients including PostNord, Nordic Wellness, and Inera (1177). Originally from Cuba, based in Göteborg since 2011.</p>
				<div class="btn-row">
					<a href="#work" class="btn">See my work →</a>
					<a href="#experience" class="btn btn-secondary">Job experience</a>
					<a href={`mailto:${EMAIL}`} class="btn btn-secondary">Get in touch</a>
				</div>
			</section>

			<section id="work">
				<div class="section-head">
					<span class="eyebrow">Selected work</span>
					<h2>Two systems I built, ship, and keep running.</h2>
					<p>Not demos. Both are live, in daily personal use, with real users (me, and whoever's in the house), real failure modes, and a written history of the decisions behind them.</p>
				</div>

				<div class="projects-grid">
					<article class="project-card card">
						<div class="project-col-a">
							<div class="project-icon"><img src={PROJECTS.turbo.icon} alt="Turbo logo" /></div>
							<span class="project-tag mono">{PROJECTS.turbo.tag}</span>
							<h3 class="project-name">{PROJECTS.turbo.name}</h3>
							<p class="project-pitch">{PROJECTS.turbo.pitch}</p>
							<div class="project-links">
								{PROJECTS.turbo.repoLinks.map((link) => (
									<a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
								))}
								<a href={`/blog/${PROJECTS.turbo.blogSlug}/`}>Read the deep dive →</a>
							</div>
						</div>
						<div class="project-col-b">
							<ul class="detail-list">
								{PROJECTS.turbo.details.map((d) => (
									<li><strong>{d.title}:</strong> {d.body}</li>
								))}
							</ul>
							<div class="stack-tags">
								{PROJECTS.turbo.stack.map((s) => <span>{s}</span>)}
							</div>
						</div>
					</article>

					<article class="project-card card">
						<div class="project-col-a">
							<div class="project-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect>
									<rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
									<path d="M10 6.5h4M6.5 10v4M17.5 10v4M10 17.5h4"></path>
								</svg>
							</div>
							<span class="project-tag mono">{PROJECTS.casaVerde.tag}</span>
							<h3 class="project-name">{PROJECTS.casaVerde.name}</h3>
							<p class="project-pitch">{PROJECTS.casaVerde.pitch}</p>
							<div class="project-links">
								{PROJECTS.casaVerde.repoLinks.map((link) => (
									<a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
								))}
								<a href={`/blog/${PROJECTS.casaVerde.blogSlug}/`}>Read the deep dive →</a>
							</div>
						</div>
						<div class="project-col-b">
							<ul class="detail-list">
								{PROJECTS.casaVerde.details.map((d) => (
									<li><strong>{d.title}:</strong> {d.body}</li>
								))}
							</ul>
							<div class="stack-tags">
								{PROJECTS.casaVerde.stack.map((s) => <span>{s}</span>)}
							</div>
						</div>
					</article>
				</div>
			</section>

			<section id="experience">
				<div class="section-head">
					<span class="eyebrow">Experience</span>
					<h2>Where the day job happens.</h2>
				</div>

				<div class="timeline">
					{[...EXPERIENCE].reverse().map((job) => (
						<div class="timeline-item card">
							<span class="timeline-node" aria-hidden="true"></span>
							<div class="timeline-head">
								<h3>{job.role}</h3>
								<span class="timeline-date mono"><span class="timeline-org">{job.org}</span><span class="timeline-dates"> · {job.dates}</span></span>
							</div>
							<ul set:html={job.bullets.map((b) => `<li>${b}</li>`).join('')} />
							<div class="stack-tags">
								{job.stack.map((s) => <span>{s}</span>)}
							</div>
						</div>
					))}
					<div class="timeline-now">
						<span class="timeline-now-dot" aria-hidden="true"></span>
						<span class="timeline-now-label">Now — Looking for new opportunities</span>
					</div>
				</div>
			</section>

			<section class="section-spaced">
				<div class="cta-band card">
					<h2>Want the fuller picture?</h2>
					<p>The About page covers the path from Cuba to Göteborg and what I do outside of code. The blog goes deep on how Turbo and casa-verde actually work. I'm looking for a team that cares about technical quality and actually ships. If that's you, let's talk.</p>
					<div class="btn-row">
						<a href="/about" class="btn">About me</a>
						<a href="/blog" class="btn btn-secondary">Read the blog</a>
					</div>
				</div>
			</section>
		</main>
		<Footer lang="en" />
	</body>
</html>

<style>
	.hero {
		padding: 3.5rem 0 3rem;
	}
	.hero .lead {
		max-width: 640px;
		font-size: 1.2rem;
		color: var(--text);
		margin-top: 1.2rem;
	}
	.hero .sub {
		max-width: 620px;
		margin-top: 1rem;
	}
	.hero .btn-row {
		margin-top: 2rem;
	}
	.btn-row {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	section {
		padding: 3.5rem 0;
	}
	.section-spaced {
		padding-top: 1rem;
	}
	.section-head {
		margin-bottom: 2.5rem;
		max-width: 640px;
	}
	.section-head p {
		margin-top: 0.8rem;
	}

	.projects-grid {
		display: grid;
		gap: 1.75rem;
	}
	.project-card {
		display: grid;
		grid-template-columns: 1.1fr 1.4fr;
		gap: 2.5rem;
		padding: 2.2rem;
	}
	.project-icon {
		height: 44px;
		width: fit-content;
		min-width: 44px;
		border-radius: 9px;
		border: 1px solid var(--border);
		background: var(--bg-elevated-2);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1rem;
		overflow: hidden;
		padding: 0 0.6rem;
	}
	.project-icon img {
		height: 60%;
		width: auto;
		object-fit: contain;
		border-radius: 0;
	}
	.project-icon svg {
		width: 24px;
		height: 24px;
		color: var(--accent);
	}
	.project-name {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.project-tag {
		color: var(--accent);
		font-size: 0.82rem;
		margin-bottom: 0.9rem;
		display: block;
	}
	.project-pitch {
		color: var(--text);
		font-size: 1.02rem;
	}
	.project-links {
		display: flex;
		gap: 1.2rem;
		margin-top: 1.3rem;
		flex-wrap: wrap;
	}
	.project-links a {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--text);
		border-bottom: 1px solid var(--border-strong);
	}
	.project-links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.detail-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.detail-list li {
		padding-left: 1.3rem;
		position: relative;
		font-size: 0.96rem;
	}
	.detail-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 6px;
		height: 6px;
		border-radius: 1px;
		background: var(--accent);
	}
	.detail-list strong {
		color: var(--text);
	}
	.stack-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.4rem;
	}
	.stack-tags span {
		font-family: var(--mono);
		font-size: 0.76rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: 5px;
		color: var(--text-dim);
		background: var(--bg-elevated-2);
	}
	@media (max-width: 860px) {
		.project-card {
			grid-template-columns: 1fr;
		}
	}

	.timeline {
		--gutter: 2.6rem;
		--line-x: 0.7rem;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
		padding-left: var(--gutter);
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: calc(var(--line-x) - 1px);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--border-strong);
	}
	.timeline-item {
		position: relative;
		padding: 1.8rem 2rem;
	}
	.timeline-node {
		position: absolute;
		left: calc(var(--line-x) - var(--gutter) - 0.45rem);
		top: 2.1rem;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
		box-shadow: 0 0 0 3px var(--bg);
	}
	.timeline-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		align-items: baseline;
		margin-bottom: 0.9rem;
	}
	.timeline-head h3 {
		color: var(--text);
	}
	.timeline-date {
		font-size: 0.82rem;
		color: var(--text);
		/* Allow long org names (e.g. "Nordic Retail Group (prev. Digital
		   People)") to wrap instead of overflowing on narrow screens. */
		white-space: normal;
		overflow-wrap: anywhere;
	}
	.timeline-org {
		color: var(--accent);
		font-weight: 600;
	}
	.timeline-item :global(ul) {
		margin: 0;
		padding-left: 1.2rem;
	}
	.timeline-item :global(li) {
		font-size: 0.96rem;
		margin-bottom: 0.5rem;
	}
	.timeline-item :global(strong) {
		color: var(--text);
	}
	.timeline-item .stack-tags span {
		color: var(--text);
		border-color: var(--border-strong);
	}
	.timeline-now {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.4rem 0 0.2rem;
	}
	.timeline-now-dot {
		position: absolute;
		left: calc(var(--line-x) - var(--gutter) - 0.5rem);
		top: 50%;
		transform: translateY(-50%);
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: var(--accent);
		animation: timeline-blink 1.6s ease-in-out infinite;
	}
	.timeline-now-label {
		font-family: var(--mono);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text);
	}
	@keyframes timeline-blink {
		0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--accent-soft-strong); }
		50% { opacity: 0.35; box-shadow: 0 0 0 7px transparent; }
	}
	@media (max-width: 640px) {
		.timeline {
			--gutter: 1.8rem;
			--line-x: 0.5rem;
		}
	}

	.cta-band {
		text-align: center;
		padding: 3rem;
	}
	.cta-band h2 {
		margin-bottom: 0.6rem;
	}
	.cta-band p {
		max-width: 480px;
		margin: 0 auto 1.6rem;
	}
	.cta-band .btn-row {
		justify-content: center;
	}

	@media (max-width: 640px) {
		.project-card {
			padding: 1.6rem;
		}
		.cta-band {
			padding: 2rem 1.4rem;
		}
		.timeline-item {
			padding: 1.4rem 1.2rem;
		}
		.timeline-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}
		.timeline-now-label {
			font-size: 0.82rem;
		}
	}
</style>
