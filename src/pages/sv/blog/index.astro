---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION_SV } from '../../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import { t } from '../../../i18n/ui';

const strings = t('sv');
const posts = (await getCollection('blog', ({ id }) => id.startsWith('sv/'))).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={`Blogg | ${SITE_TITLE}`} description={SITE_DESCRIPTION_SV} />
	</head>
	<body>
		<Header lang="sv" />
		<main>
			<section class="section-head">
				<span class="eyebrow">{strings.blogList.eyebrow}</span>
				<h1>{strings.blogList.title}</h1>
				<p>{strings.blogList.description}</p>
			</section>

			<section class="post-list">
				{posts.map((post) => (
					<a class="post-row card" href={`/sv/blog/${post.id.replace(/^sv\//, '')}/`}>
						{post.data.heroImage && (
							<div class="post-thumb">
								<img src={post.data.heroImage} alt="" />
							</div>
						)}
						<div class="post-copy">
							<div class="post-title">{post.data.title}</div>
							<p class="post-desc">{post.data.description}</p>
						</div>
						<span class="post-date mono">
							<FormattedDate date={post.data.pubDate} lang="sv" />
						</span>
					</a>
				))}
			</section>
		</main>
		<Footer lang="sv" />
	</body>
</html>

<style>
	.section-head {
		max-width: 640px;
		margin-bottom: 2.5rem;
	}
	.section-head p {
		margin-top: 0.8rem;
	}
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}
	.post-row {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		align-items: center;
		padding: 1.4rem 1.9rem;
		margin: 0;
	}
	.post-thumb {
		width: 84px;
		height: 84px;
		flex-shrink: 0;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-elevated-2);
		overflow: hidden;
	}
	.post-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.post-copy {
		flex: 1;
		min-width: 0;
	}
	.post-title {
		color: var(--text);
		font-size: 1.1rem;
		font-weight: 700;
		margin-bottom: 0.35rem;
	}
	.post-desc {
		margin: 0;
		font-size: 0.92rem;
	}
	.post-date {
		font-size: 0.8rem;
		color: var(--text-dim);
		white-space: nowrap;
	}
	@media (max-width: 600px) {
		.post-row {
			flex-direction: column;
			align-items: flex-start;
			padding: 1.2rem 1.2rem;
		}
		.post-thumb {
			width: 100%;
			height: 140px;
		}
		.post-date {
			white-space: normal;
		}
	}
</style>
