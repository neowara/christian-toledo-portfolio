---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import ClientGrid from '../../components/ClientGrid.astro';
import SystemsSection from '../../components/SystemsSection.astro';
import AiSection from '../../components/AiSection.astro';
import GithubSection from '../../components/GithubSection.astro';
import CvSection from '../../components/CvSection.astro';
import { SITE_TITLE, SITE_DESCRIPTION_SV, EMAIL, PROJECTS_SV, EXPERIENCE_SV } from '../../consts';
import { t } from '../../i18n/ui';

const strings = t('sv');
const projects = [PROJECTS_SV.cityroam, PROJECTS_SV.casaVerde];
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION_SV} />
	</head>
	<body>
		<Header lang="sv" />
		<main>
			<section class="hero">
				<span class="eyebrow">Göteborg, Sverige</span>
				<h1>Christian Toledo.<br>Fullstackutvecklare som bygger och driftar sina egna system.</h1>
				<p class="lead">Närmare sju år av att bygga webb- och mobilappar i produktion, på produktbolag och som konsult. React, React Native, Vue, Angular och .NET, för kunder som <strong>PostNord</strong>, <strong>Nordic Wellness</strong> och <strong>Ineras 1177</strong>, den nationella vårdplattform som miljontals svenskar använder. På fritiden bygger jag på samma sätt: en färdapp som nu ligger i stängd beta, byggd på två tillverkares Bluetooth-protokoll som jag reverse-engineerat själv, och ett hemmalabb med fem system som jag driftar och dokumenterar som produktion.</p>
				<p class="sub">Senast fullstackutvecklare på Dear Friends och Nexer AB. Ursprungligen från Kuba, bosatt i Göteborg sedan 2011, och söker just nu mitt nästa team.</p>
				<div class="btn-row">
					<a href="#work" class="btn">Se mina projekt →</a>
					<a href="#experience" class="btn btn-secondary">Erfarenhet</a>
					<a href="/sv/cv" class="btn btn-secondary">CV</a>
					<a href={`mailto:${EMAIL}`} class="btn btn-secondary">Hör av dig</a>
				</div>
			</section>

			<section id="work">
				<div class="section-head">
					<span class="eyebrow">Utvalda projekt</span>
					<h2>Två saker jag byggt, driftar och håller igång.</h2>
					<p>Inga demos. Det ena är en Android-app och backend i stängd beta med riktiga användare; det andra är plattformen den körs på. Båda har verkliga felfall, och en nedskriven historik över besluten bakom dem: protokollreverseringen, fysikregressionerna och de infrastrukturval som gjordes i vardera.</p>
				</div>

				<div class="projects-grid">
					{projects.map((project) => (
						<article class="project-card card">
							<div class="project-col-a">
								<div class="project-icon">
									{project.icon
										? <img src={project.icon} alt="" />
										: <Icon name="platform" size={24} />}
								</div>
								<span class="project-tag mono">{project.tag}</span>
								<h3 class="project-name">{project.name}</h3>
								<p class="project-pitch">{project.pitch}</p>
								<div class="project-links">
									{project.links.map((link) => (
										<a
											href={link.url}
											target={link.external ? '_blank' : undefined}
											rel={link.external ? 'noopener noreferrer' : undefined}
										>{link.label}{link.external ? ' ↗' : ''}</a>
									))}
								</div>
								<p class="project-source">{project.sourceNote}</p>
							</div>
							<div class="project-col-b">
								<ul class="detail-list">
									{project.details.map((d) => (
										<li><strong>{d.title}:</strong> {d.body}</li>
									))}
								</ul>
								<div class="stack-tags">
									{project.stack.map((s) => <span>{s}</span>)}
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<SystemsSection lang="sv" />

			<section id="experience">
				<div class="section-head">
					<span class="eyebrow">Erfarenhet</span>
					<h2>Där jobbet faktiskt händer.</h2>
					<p>Nio års anställning på produktbolag och i konsultverksamhet. Som konsult är arbetsgivaren den som betalade, men kunden är vad arbetet faktiskt var, så båda finns med.</p>
				</div>

				<div class="timeline">
					{[...EXPERIENCE_SV].reverse().map((job) => (
						<div class="timeline-item card">
							<span class="timeline-node" aria-hidden="true"></span>
							<div class="timeline-head">
								<h3>{job.role}</h3>
								<span class="timeline-date mono"><span class="timeline-org">{job.org}</span><span class="timeline-dates"> · {job.dates}</span></span>
							</div>
							<ul set:html={job.bullets.map((b) => `<li>${b}</li>`).join('')} />
							{job.clients && (
								<ClientGrid clients={job.clients} label={strings.clients.label} />
							)}
							<div class="stack-tags">
								{job.stack.map((s) => <span>{s}</span>)}
							</div>
						</div>
					))}
					<div class="timeline-now">
						<span class="timeline-now-dot" aria-hidden="true"></span>
						<span class="timeline-now-label">Nu &middot; Söker nya möjligheter</span>
					</div>
				</div>

				<p class="clients-disclaimer">{strings.clients.disclaimer}</p>
			</section>

			<AiSection lang="sv" />

			<GithubSection lang="sv" />

			<CvSection lang="sv" />

			<section class="section-spaced">
				<div class="cta-band card">
					<h2>Vill du veta mer?</h2>
					<p>Om mig-sidan täcker vägen från Kuba till Göteborg och vad jag gör utanför koden, och bloggen går in på hur Cityroam och casa-verde fungerar. Jag söker ett team som bryr sig om teknisk kvalitet och levererar på riktigt. Låter det som ni, hör av er.</p>
					<div class="btn-row">
						<a href="/sv/about" class="btn">Om mig</a>
						<a href="/sv/blog" class="btn btn-secondary">Läs bloggen</a>
					</div>
				</div>
			</section>
		</main>
		<Footer lang="sv" />
	</body>
</html>
<style>
	.hero {
		padding: 3.5rem 0 3rem;
	}
	.hero .lead {
		max-width: 640px;
		font-size: 1.2rem;
		color: var(--text);
		margin-top: 1.2rem;
	}
	.hero .sub {
		max-width: 620px;
		margin-top: 1rem;
	}
	.hero .btn-row {
		margin-top: 2rem;
	}
	.btn-row {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	section {
		padding: 3.5rem 0;
	}
	.section-spaced {
		padding-top: 1rem;
	}
	.section-head {
		margin-bottom: 2.5rem;
		max-width: 640px;
	}
	.section-head p {
		margin-top: 0.8rem;
	}

	.projects-grid {
		display: grid;
		gap: 1.75rem;
	}
	.project-card {
		display: grid;
		grid-template-columns: 1.1fr 1.4fr;
		gap: 2.5rem;
		padding: 2.2rem;
	}
	.project-icon {
		height: 44px;
		width: fit-content;
		min-width: 44px;
		border-radius: 9px;
		border: 1px solid var(--border);
		background: var(--bg-elevated-2);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1rem;
		overflow: hidden;
		padding: 0 0.6rem;
	}
	.project-icon img {
		height: 60%;
		width: auto;
		object-fit: contain;
		border-radius: 0;
	}
	.project-icon svg {
		width: 24px;
		height: 24px;
		color: var(--accent);
	}
	.project-name {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.project-tag {
		color: var(--accent);
		font-size: 0.82rem;
		margin-bottom: 0.9rem;
		display: block;
	}
	.project-pitch {
		color: var(--text);
		font-size: 1.02rem;
	}
	.project-links {
		display: flex;
		gap: 1.2rem;
		margin-top: 1.3rem;
		flex-wrap: wrap;
	}
	.project-links a {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--text);
		border-bottom: 1px solid var(--border-strong);
	}
	.project-links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.project-source {
		margin: 0.9rem 0 0;
		font-size: 0.82rem;
		color: var(--text-dim);
		line-height: 1.55;
		max-width: 46ch;
	}
	.clients-disclaimer {
		margin: 1.6rem 0 0;
		font-size: 0.78rem;
		color: var(--text-dim);
		max-width: 70ch;
		line-height: 1.6;
	}
	.detail-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.detail-list li {
		padding-left: 1.3rem;
		position: relative;
		font-size: 0.96rem;
	}
	.detail-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 6px;
		height: 6px;
		border-radius: 1px;
		background: var(--accent);
	}
	.detail-list strong {
		color: var(--text);
	}
	.stack-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.4rem;
	}
	.stack-tags span {
		font-family: var(--mono);
		font-size: 0.76rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: 5px;
		color: var(--text-dim);
		background: var(--bg-elevated-2);
	}
	@media (max-width: 860px) {
		.project-card {
			grid-template-columns: 1fr;
		}
	}

	.timeline {
		--gutter: 2.6rem;
		--line-x: 0.7rem;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
		padding-left: var(--gutter);
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: calc(var(--line-x) - 1px);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--border-strong);
	}
	.timeline-item {
		position: relative;
		padding: 1.8rem 2rem;
	}
	.timeline-node {
		position: absolute;
		left: calc(var(--line-x) - var(--gutter) - 0.45rem);
		top: 2.1rem;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
		box-shadow: 0 0 0 3px var(--bg);
	}
	.timeline-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		align-items: baseline;
		margin-bottom: 0.9rem;
	}
	.timeline-head h3 {
		color: var(--text);
	}
	.timeline-date {
		font-size: 0.82rem;
		color: var(--text);
		/* Allow long org names (e.g. "Nordic Retail Group (prev. Digital
		   People)") to wrap instead of overflowing on narrow screens. */
		white-space: normal;
		overflow-wrap: anywhere;
	}
	.timeline-org {
		color: var(--accent);
		font-weight: 600;
	}
	.timeline-item :global(ul) {
		margin: 0;
		padding-left: 1.2rem;
	}
	.timeline-item :global(li) {
		font-size: 0.96rem;
		margin-bottom: 0.5rem;
	}
	.timeline-item :global(strong) {
		color: var(--text);
	}
	.timeline-item .stack-tags span {
		color: var(--text);
		border-color: var(--border-strong);
	}
	.timeline-now {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.4rem 0 0.2rem;
	}
	.timeline-now-dot {
		position: absolute;
		left: calc(var(--line-x) - var(--gutter) - 0.5rem);
		top: 50%;
		transform: translateY(-50%);
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: var(--accent);
		animation: timeline-blink 1.6s ease-in-out infinite;
	}
	.timeline-now-label {
		font-family: var(--mono);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text);
	}
	@keyframes timeline-blink {
		0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--accent-soft-strong); }
		50% { opacity: 0.35; box-shadow: 0 0 0 7px transparent; }
	}
	@media (max-width: 640px) {
		.timeline {
			--gutter: 1.8rem;
			--line-x: 0.5rem;
		}
	}

	.cta-band {
		text-align: center;
		padding: 3rem;
	}
	.cta-band h2 {
		margin-bottom: 0.6rem;
	}
	.cta-band p {
		max-width: 480px;
		margin: 0 auto 1.6rem;
	}
	.cta-band .btn-row {
		justify-content: center;
	}

	@media (max-width: 640px) {
		.project-card {
			padding: 1.6rem;
		}
		.cta-band {
			padding: 2rem 1.4rem;
		}
		.timeline-item {
			padding: 1.4rem 1.2rem;
		}
		.timeline-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}
		.timeline-now-label {
			font-size: 0.82rem;
		}
	}
</style>
