---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CvContent from '../components/CvContent.astro';
import { SITE_TITLE } from '../consts';
import { t } from '../i18n/ui';

const strings = t('en').cv;
const title = `CV | ${SITE_TITLE}`;
const description =
	"Christian Toledo's CV — full-stack developer in Göteborg, Sweden. Close to seven years across React, React Native, Vue, Angular, .NET and mobile, for clients including PostNord, Nordic Wellness and 1177.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="alternate" hreflang="en" href="/cv" />
		<link rel="alternate" hreflang="sv" href="/sv/cv" />
	</head>
	<body>
		<Header lang="en" />
		<main>
			<CvContent lang="en" />
			<p class="cv-foot">
				<a href="/">{strings.backHome}</a>
			</p>
		</main>
		<Footer lang="en" />
	</body>
</html>

<style>
	main {
		padding-top: 2.5rem;
	}
	.cv-foot {
		margin: 2.5rem 0 0;
		font-size: 0.9rem;
	}
	@media print {
		.cv-foot {
			display: none;
		}
	}
</style>
