---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage?.endsWith('.svg') ? undefined : heroImage} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.prose {
				width: var(--container-width);
				max-width: calc(100% - 3em);
				margin: auto;
				padding: 3rem 0 4rem;
			}
			.prose :global(h2) {
				margin-top: 2.4rem;
				margin-bottom: 1rem;
				font-size: 1.4rem;
			}
			.prose :global(h3) {
				margin-top: 1.8rem;
				margin-bottom: 0.8rem;
			}
			.prose :global(p) {
				font-size: 1.02rem;
			}
			.prose :global(figure) {
				margin: 2rem 0;
				text-align: center;
			}
			.prose :global(figure img) {
				width: auto;
				max-width: 100%;
				max-height: 65vh;
				margin: 0 auto;
				border: 1px solid var(--border);
				cursor: zoom-in;
			}
			.prose :global(figcaption) {
				margin-top: 0.7rem;
				font-size: 0.85rem;
				color: var(--text-dim);
				text-align: center;
				font-family: var(--mono);
			}
			.lightbox {
				position: fixed;
				inset: 0;
				display: none;
				background: rgba(0, 0, 0, 0.9);
				z-index: 1000;
			}
			.lightbox.is-open {
				display: block;
			}
			.lightbox-stage {
				width: 100%;
				height: 100%;
				overflow: auto;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 3vh 3vw;
				cursor: default;
			}
			.lightbox-stage.is-zoomed {
				cursor: grab;
				align-items: flex-start;
				justify-content: flex-start;
			}
			.lightbox-stage.is-panning {
				cursor: grabbing;
			}
			.lightbox img {
				max-width: 90vw;
				max-height: 90vh;
				border-radius: var(--radius-sm);
				box-shadow: var(--shadow);
				user-select: none;
			}
			.lightbox-stage.is-zoomed img {
				max-width: none;
				max-height: none;
			}
			.lightbox-controls {
				position: fixed;
				top: 1.2rem;
				right: 4.6rem;
				display: flex;
				align-items: center;
				gap: 0.4rem;
				background: var(--bg-elevated);
				border: 1px solid var(--border-strong);
				border-radius: var(--radius);
				padding: 0.4rem;
				z-index: 1002;
			}
			.lightbox-controls button {
				font-family: var(--mono);
				font-size: 1rem;
				line-height: 1;
				color: var(--text);
				background: none;
				border: none;
				cursor: pointer;
				padding: 0.5rem 0.8rem;
				border-radius: var(--radius-sm);
			}
			.lightbox-controls button:hover {
				background: var(--accent-soft);
				color: var(--accent);
			}
			.lightbox-close {
				position: fixed;
				top: 1.2rem;
				right: 1.5rem;
				font-family: var(--mono);
				font-size: 1.6rem;
				line-height: 1;
				color: var(--text);
				background: none;
				border: none;
				cursor: pointer;
				z-index: 1002;
			}
			.title {
				margin-bottom: 1em;
				text-align: left;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.meta {
				font-family: var(--mono);
				font-size: 0.82rem;
				color: var(--text-dim);
				margin-bottom: 1rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-bottom: 1.5rem;
			}
			.back-link:hover {
				color: var(--accent);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<a href="/blog" class="back-link mono">&larr; Back to blog</a>
					<div class="title">
						<div class="meta">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										, last updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<div class="lightbox" id="lightbox">
			<button class="lightbox-close" id="lightbox-close" aria-label="Close image">&times;</button>
			<div class="lightbox-stage" id="lightbox-stage">
				<img id="lightbox-img" src="" alt="" />
			</div>
			<div class="lightbox-controls">
				<button id="lightbox-zoom-out" aria-label="Zoom out">&minus;</button>
				<button id="lightbox-zoom-reset" aria-label="Reset zoom">Reset</button>
				<button id="lightbox-zoom-in" aria-label="Zoom in">&plus;</button>
			</div>
		</div>
		<Footer />
	</body>
</html>
<script>
	const lightbox = document.getElementById('lightbox') as HTMLDivElement;
	const stage = document.getElementById('lightbox-stage') as HTMLDivElement;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

	const MIN_SCALE = 1;
	const MAX_SCALE = 6;
	let scale = 1;
	let isPanning = false;
	let didDrag = false;
	let panStartX = 0;
	let panStartY = 0;
	let scrollStartX = 0;
	let scrollStartY = 0;

	function applyZoom(newScale: number, anchorClientX?: number, anchorClientY?: number) {
		newScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, newScale));
		if (newScale === scale) return;

		if (newScale > MIN_SCALE) {
			const rect = lightboxImg.getBoundingClientRect();
			const ax = anchorClientX ?? rect.left + rect.width / 2;
			const ay = anchorClientY ?? rect.top + rect.height / 2;
			const ratioX = (ax - rect.left) / rect.width;
			const ratioY = (ay - rect.top) / rect.height;

			const baseWidth = lightboxImg.naturalWidth
				? Math.min(lightboxImg.naturalWidth, window.innerWidth * 0.9)
				: rect.width;
			const targetWidth = baseWidth * newScale;

			stage.classList.add('is-zoomed');
			lightboxImg.style.width = `${targetWidth}px`;
			lightboxImg.style.height = 'auto';

			requestAnimationFrame(() => {
				const newRect = lightboxImg.getBoundingClientRect();
				const targetX = ratioX * newRect.width - (ax - stage.getBoundingClientRect().left) + stage.scrollLeft;
				const targetY = ratioY * newRect.height - (ay - stage.getBoundingClientRect().top) + stage.scrollTop;
				stage.scrollLeft = targetX;
				stage.scrollTop = targetY;
			});
		} else {
			stage.classList.remove('is-zoomed');
			lightboxImg.style.width = '';
			lightboxImg.style.height = '';
			stage.scrollLeft = 0;
			stage.scrollTop = 0;
		}
		scale = newScale;
	}

	function openLightbox(src: string, alt: string) {
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		lightbox.classList.add('is-open');
		scale = 1;
		stage.classList.remove('is-zoomed');
		lightboxImg.style.width = '';
		lightboxImg.style.height = '';
	}

	function closeLightbox() {
		lightbox.classList.remove('is-open');
		lightboxImg.src = '';
	}

	document.querySelectorAll('.prose figure img').forEach((img) => {
		img.addEventListener('click', () => {
			openLightbox((img as HTMLImageElement).src, (img as HTMLImageElement).alt);
		});
	});

	document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
	document.getElementById('lightbox-zoom-in')?.addEventListener('click', () => applyZoom(scale + 1));
	document.getElementById('lightbox-zoom-out')?.addEventListener('click', () => applyZoom(scale - 1));
	document.getElementById('lightbox-zoom-reset')?.addEventListener('click', () => applyZoom(MIN_SCALE));

	lightboxImg.addEventListener('dragstart', (e) => e.preventDefault());

	stage.addEventListener('click', (e) => {
		if (didDrag) {
			didDrag = false;
			return;
		}
		if (e.target !== lightboxImg) closeLightbox();
	});

	stage.addEventListener('wheel', (e) => {
		if (!lightboxImg.src) return;
		e.preventDefault();
		applyZoom(scale + (e.deltaY < 0 ? 1 : -1), e.clientX, e.clientY);
	}, { passive: false });

	stage.addEventListener('mousedown', (e) => {
		if (scale <= MIN_SCALE) return;
		isPanning = true;
		didDrag = false;
		stage.classList.add('is-panning');
		panStartX = e.clientX;
		panStartY = e.clientY;
		scrollStartX = stage.scrollLeft;
		scrollStartY = stage.scrollTop;
		e.preventDefault();
	});
	window.addEventListener('mousemove', (e) => {
		if (!isPanning) return;
		if (Math.abs(e.clientX - panStartX) > 3 || Math.abs(e.clientY - panStartY) > 3) didDrag = true;
		stage.scrollLeft = scrollStartX - (e.clientX - panStartX);
		stage.scrollTop = scrollStartY - (e.clientY - panStartY);
	});
	window.addEventListener('mouseup', () => {
		isPanning = false;
		stage.classList.remove('is-panning');
	});

	document.addEventListener('keydown', (e) => {
		if (!lightbox.classList.contains('is-open')) return;
		if (e.key === 'Escape') closeLightbox();
		if (e.key === '+' || e.key === '=') applyZoom(scale + 1);
		if (e.key === '-') applyZoom(scale - 1);
	});
</script>
